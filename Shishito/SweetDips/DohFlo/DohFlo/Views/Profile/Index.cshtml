@model DohFlo.Models.Profile.ProfileViewModel
@using DohFlo.Security

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4">My Profile</h1>

                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success" role="alert">
                            @successMessage
                        </div>
                    }

                    <dl class="row mb-4">
                        <dt class="col-sm-4">
                            Display Name
                        </dt>

                        <dd class="col-sm-8">
                            @Model.DisplayName
                        </dd>

                        <dt class="col-sm-4">
                            Email
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Email
                        </dd>

                        <dt class="col-sm-4">
                            Role
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Role
                        </dd>
                    </dl>

                    @if (User.IsInRole(FinanceAccess.AdminRole))
                    {
                        <hr />

                        <h2 class="h5 mb-3">
                            Security
                        </h2>

                        <p class="text-muted">
                            Update the password for your Admin account.
                        </p>

                        <a asp-controller="Auth"
                           asp-action="ChangePassword"
                           class="btn btn-outline-primary">
                            Change Password
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>