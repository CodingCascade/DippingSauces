@using DohFlo.Security
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DohFlo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css"><!-- Added Bootstrap icons -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DohFlo.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/DohFlo-icon.png" />
    <link rel="icon" type="image/x-icon" href="~/images/DohFlo-favicon.ico" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark border-bottom box-shadow mb-3" id="top-nav-bar" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/DohFlo-logo-white-text-transparent-bg.png" alt="DohFlo" class="dohflo-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-menu"
                        aria-controls="main-menu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-menu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill me-1" aria-hidden="true"></i>Home
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle" id="transactions-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-cash-stack me-1" aria-hidden="true"></i>Transactions
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="transactions-menu">
                                    <li><a class="dropdown-item" asp-controller="Transactions" asp-action="Create"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Add Transactions</a></li>
                                    <li><a class="dropdown-item" asp-controller="Transactions" asp-action="Index"><i class="bi bi-arrow-left-right me-2" aria-hidden="true"></i>View Transactions</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle" id="transaction-settings-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear me-1" aria-hidden="true"></i>Transaction Settings
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="transaction-settings-menu">
                                    <li><a class="dropdown-item" asp-controller="Accounts" asp-action="Index"><i class="bi bi-wallet2 me-2" aria-hidden="true"></i>Accounts</a></li>
                                    <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags me-2" aria-hidden="true"></i>Categories</a></li>
                                    <li><a class="dropdown-item" asp-controller="Payees" asp-action="Index">
                                            <i class="bi bi-person-vcard me-2" aria-hidden="true"></i>Payees
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle" id="account-settings-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-gear me-1" aria-hidden="true"></i>
                                    Account Settings
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="account-settings-menu">
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle me-2" aria-hidden="true"></i>My Profile</a></li>
                                    @if (User.IsInRole(FinanceAccess.AdminRole))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Auth" asp-action="ChangePassword"><i class="bi bi-key me-2" aria-hidden="true"></i>Change Password</a></li>
                                        <li><a class="dropdown-item" asp-controller="AccountUsers" asp-action="Index"><i class="bi bi-people me-2" aria-hidden="true"></i>Account Users</a></li>
                                        <li><a class="dropdown-item" asp-controller="AccountsLab" asp-action="Index"><i class="bi bi-code-slash me-2" aria-hidden="true"></i>Accounts (Vue.js)</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" asp-antiforgery="true">
                                            <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Sign in</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top mt-auto py-4 bg-body">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3 small">
            <div class="d-flex align-items-center gap-3">
                <span class="text-body-secondary">Copyright &copy; @DateTime.Now.Year <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="Index">DohFlo</a>. All rights reserved.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <ul class="list-inline">
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="PrivacyPolicy">Privacy Policy</a></li>
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="CookiePolicy">Cookie Policy</a></li>
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="SiteDisclaimer">Site Disclaimer</a></li>
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="SiteMap">Site Map</a></li>
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="ContactUs">Contact Us</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>