@model IReadOnlyList<DohFlo.Data.Account>

@{
    ViewData["Title"] = "Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Accounts</h1>
        <p class="text-muted mb-0">
            Accounts available for your transactions.
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary" id="btn-dohflo-primary">Add Account</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}

@if(Model.Count == 0)
{
    <div class="alert alert-info">
        You do not have any accounts yet.
        Select <strong>Add Account</strong> to create one.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Institution</th>
                    <th>Currency</th>
                    <th>Status</th>
                    <th class="text-center">Edit</th>
                    <th class="text-star">Close/Re-Open</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var account in Model)
                {
                    <tr>
                        <td>@account.Name</td>
                        <td>@account.Type</td>
                        <td>
                            @(string.IsNullOrWhiteSpace(account.Institution) ? "-" : account.Institution)
                        </td>
                        <td>@account.CurrencyCode</td>
                        <td>
                            <span class="badge @(account.IsClosed ? "text-bg-secondary" : "text-bg-success")">
                                @(account.IsClosed ? "Closed" : "Open")
                            </span>
                        </td>
                        
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@account.Id" class="btn btn-sm btn-outline-primary d-inline-flex flex-column align-items-center gap-1 px-4 py-1" aria-label="Edit account">
                                <i class="bi bi-pencil-square"></i> 
                                Edit
                            </a>
                        </td>
                        <td class="text-start">
                            <form asp-action="ToggleClosed" asp-route-id="@account.Id" method="post">
                                @if (account.IsClosed)
                                    {
                                    <button type="submit" class="btn btn-sm btn-outline-success d-inline-flex flex-column align-items-center gap-1 px-3 py-1" aria-label="Reopen account">
                                            <i class="bi bi-unlock"></i>
                                            Reopen
                                        </button>
                                    }
                                else
                                    {
                                    <button type="submit" class="btn btn-sm btn-outline-secondary d-inline-flex flex-column align-items-center gap-1 px-3 py-1" aria-label="Close account">
                                           <i class="bi bi-lock"></i>
                                           Close
                                       </button> 
                                    }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}