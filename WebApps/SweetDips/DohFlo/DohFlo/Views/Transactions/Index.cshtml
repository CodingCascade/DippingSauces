@model IReadOnlyList<DohFlo.Data.Transaction>

@{
    ViewData["Title"] = "Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Transactions</h1>
        <p class="text-muted mb-0">
            Review your income and expenses.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary"
       id="btn-dohflo-primary">
        Add Transaction
    </a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You do not have any transactions yet.
        Select <strong>Add Transaction</strong> to create one.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Payee</th>
                    <th>Category</th>
                    <th>Account</th>
                    <th>Status</th>
                    <th>Amount</th>
                    <th>Notes</th>
                    <th class="text-center">Edit</th>
                    <th class="text-center">Delete</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var transaction in Model)
                {
                    <tr>
                        <td>@transaction.Date.ToString("MM/dd/yyyy")</td>

                        <td>
                            @(transaction.Payee?.Name ?? "—")
                        </td>

                        <td>
                            @(transaction.Category?.Name ?? "—")
                        </td>

                        <td>
                            @(transaction.Account?.Name ?? "—")
                        </td>

                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (transaction.IsPending)
                                {
                                    <span class="badge text-bg-warning">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">
                                        Reconciled
                                    </span>
                                }

                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link text-secondary p-0"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="Change transaction status">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <form asp-action="UpdateStatus" method="post">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@transaction.Id" />

                                                <input type="hidden"
                                                       name="isPending"
                                                       value="true" />

                                                <button type="submit"
                                                        class="dropdown-item"
                                                        disabled="@transaction.IsPending">
                                                    Mark as Pending
                                                </button>
                                            </form>
                                        </li>

                                        <li>
                                            <form asp-action="UpdateStatus" method="post">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@transaction.Id" />

                                                <input type="hidden"
                                                       name="isPending"
                                                       value="false" />

                                                <button type="submit"
                                                        class="dropdown-item"
                                                        disabled="@(!transaction.IsPending)">
                                                    Mark as Reconciled
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </td>

                        <td>
                            @transaction.Amount.ToString("C2")
                        </td>
                        <td class="text-wrap">
                            @transaction.Notes
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit"
                               asp-route-id="@transaction.Id"
                               class="btn btn-sm btn-outline-primary"
                               aria-label="Edit transaction">
                                <i class="bi bi-pencil-square"></i>
                                Edit
                            </a>
                        </td>

                        <td class="text-center">
                            <form asp-action="Delete"
                                  asp-route-id="@transaction.Id"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this transaction?');">

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        aria-label="Delete transaction">
                                    <i class="bi bi-trash"></i>
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}