<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DohFlo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DohFlo.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Nav bar version 1 --></>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3" id="top-nav-bar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/DohFlo-logo-white-text.png"
                         alt="DohFlo Logo"
                         class="dohflo-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="main-menu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Accounts" asp-action="Index">Accounts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Transactions" asp-action="Create">Add Transaction</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Sign in</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top mt-auto py-4 bg-body">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3 small">
            <div class="d-flex align-items-center gap-3">
                <span class="text-body-secondary">Copyright &copy; @DateTime.Now.Year <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="Index">DohFlo</a>. All rights reserved.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="PrivacyPolicy">Privacy Policy - </a>
                <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="CookiePolicy">Cookie Policy - </a>
                <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="SiteDisclaimer">Site Disclaimer - </a>
                <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="SiteMap">Site Map - </a>
                <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
