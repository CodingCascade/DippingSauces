<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DohFlo</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"><!-- Added Bootstrap icons -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DohFlo.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/DohFlo-icon.png" />
    <link rel="icon" type="image/x-icon" href="~/images/DohFlo-favicon.ico" />
</head>
<body>
    <header>
        <!-- Nav bar version 1 -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3" id="top-nav-bar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/DohFlo-logo-white-text-transparent-bg.png"
                         alt="DohFlo Logo"
                         class="dohflo-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="main-menu">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-cash-stack"></i> Transactions
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Transactions"
                                       asp-action="Create">
                                        <i class="bi bi-plus-circle me-1"></i>
                                        Add Transactions
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Transactions"
                                       asp-action="Index">
                                        <i class="bi bi-arrow-left-right"></i>
                                        View Transactions
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class="bi bi-gear me-1"></i> Settings
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Accounts"
                                       asp-action="Index">
                                        <i class="bi bi-wallet2 me-2"></i>
                                        Accounts
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Categories"
                                       asp-action="Index">
                                        <i class="bi bi-tags me-2"></i>
                                        Categories
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Payees"
                                       asp-action="Index">
                                        <i class="bi bi-people me-2"></i>
                                        Payees
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="signin" asp-action="Index"><i class="bi bi-person-circle"></i> Sign in</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top mt-auto py-4 bg-body">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3 small">
            <div class="d-flex align-items-center gap-3">
                <span class="text-body-secondary">Copyright &copy; @DateTime.Now.Year <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="Index">DohFlo</a>. All rights reserved.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <ul class="list-inline">
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="PrivacyPolicy">Privacy Policy</a></li>
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="CookiePolicy">Cookie Policy</a></li>
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="SiteDisclaimer">Site Disclaimer</a></li>
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="SiteMap">Site Map</a></li>
                    <li class="list-inline-item"><a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="ContactUs">Contact Us</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
