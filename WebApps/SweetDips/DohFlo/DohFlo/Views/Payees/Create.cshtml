@model DohFlo.Models.PayeeFormViewModel

@{ 
    ViewData["Title"] = "Add Payee";
}

<h1>Add Payee</h1>

<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">Create Payee</button>
    <a asp-action="Index" class="btn btn-outline-secondry">Cancel</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" />} 