@model IReadOnlyList<DohFlo.Data.Payee>

@{
    ViewData["Title"] = "Payees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Payees</h1>
        <p class="text-muted mb-0">Names used when entering transactions.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Payee</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">You do not have any payees yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payee in Model)
                {
                    <tr>
                        <td>@payee.Name</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@payee.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@payee.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}